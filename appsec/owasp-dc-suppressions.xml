<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    False-positive suppressions for portal-nav-api.

    HOW TO ADD A SUPPRESSION:
      1. Run OWASP-DC locally and identify the CVE.
      2. Confirm it is a false positive (wrong package, irrelevant code path).
      3. Add a <suppress> entry below with:
           - <notes>: reason + ticket/sprint reference
           - <cve>: exact CVE ID
           - <packageUrl>: exact pkg:pypi/... or pkg:npm/... regex

    DO NOT suppress HIGH/CRITICAL findings without a documented justification.
    All suppressions are reviewed in quarterly security reviews.
  -->

  <!-- Example (commented out):
  <suppress>
    <notes>
      CVE-2023-XXXXX: false positive — this CVE affects the HTTP server component
      of psycopg2 which we do not use. We use the library in a Lambda with no
      inbound network exposure. Reviewed sprint-12, expires 2025-06-01.
    </notes>
    <packageUrl regex="true">^pkg:pypi/psycopg2-binary@.*$</packageUrl>
    <cve>CVE-2023-XXXXX</cve>
  </suppress>
  -->
</suppressions>
